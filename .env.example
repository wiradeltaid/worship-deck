# Signed session cookie HMAC secret (required for hub auth; minimum 16 characters).
# Insecure placeholders (change-me*, your-secret-here*, secret, password) are rejected at startup.
AUTH_SECRET=change-me-to-a-long-random-string

# Bootstrap first admin when the accounts table is empty (optional)
AUTH_BOOTSTRAP_USER=admin
AUTH_BOOTSTRAP_PASSWORD=change-me-bootstrap

# DEPRECATED: shared Basic Auth password — no longer used as the hub gate (Story 6.2).
# AUTH_PASSWORD=

# Shared secret for Telegram/picoclaw webhook (required).
# Send as header: X-Webhook-Secret: <value>
WEBHOOK_SECRET=change-me-webhook

# Optional absolute path for SQLite database (defaults to ./data.db)
# DB_PATH=

# Go API listen. Unset LISTEN_HOST binds 127.0.0.1 (no Windows Firewall prompt).
# Docker images set LISTEN_HOST=0.0.0.0; do not set that on a bare Windows host.
# PORT=3000
# LISTEN_HOST=127.0.0.1

# Optional comma-separated image host allowlist for remote PPTX/announcement embeds (SSRF harden).
# When unset, http(s) is allowed but localhost/private/link-local/metadata IPs are blocked.
# Does not apply to hub-local /api/uploads/... paths.
# IMAGE_URL_ALLOWLIST=cdn.example.com,images.example.org

# Optional absolute directory for announcement file uploads (default: ./data/uploads).
# In Docker, leave unset so the compose volume at /app/data/uploads is used.
# UPLOADS_DIR=

# Cached PPTX retention days (Phase 4). 0 = keep forever. Default 60.
# PPTX_RETENTION_DAYS=60
# PPTX_CACHE_DIR=

# --- Docker Compose / LiveServer Variables ---
# In LiveServer, these paths tell compose where to bind the volumes from the host.
# They are not read by the Node process (the container sets internal paths).
# HOST_DB_FILE=D:/LiveServer/presenter.example.org/data.db
# HOST_PPTX_CACHE=D:/LiveServer/presenter.example.org/cache/pptx
# HOST_UPLOADS_DIR=D:/LiveServer/presenter.example.org/uploads
# HOST_DEV_DB_FILE=D:/LiveServer/presenter.example.org/data.dev.db
# HOST_DEV_PPTX_CACHE=D:/LiveServer/presenter.example.org/cache/dev-pptx
# HOST_DEV_UPLOADS_DIR=D:/LiveServer/presenter.example.org/dev-uploads

